// 100 operations per call: the cost of one is (this - `empty loop`) / 100
pub fn pre_bench() {
    let Vec3 = import_namespace("math").Vec3;
    (Vec3, Vec3.new(1.0, 2.0, 3.0), Vec3.new(4.0, 5.0, 6.0))
}

pub fn bench(s) {
    let (vec3, v, w) = s;
    for i in 0..100 {
        let c = vec3.new(1.0, 2.0, 3.0);
    }
}
