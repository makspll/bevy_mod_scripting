// 100 operations per call
pub fn pre_bench() {
    let Mat3 = import_namespace("math").Mat3;
    let Vec3 = import_namespace("math").Vec3;
    Mat3.from_cols(Vec3.new(1.0, 0.0, 0.0), Vec3.new(0.0, 2.0, 0.0), Vec3.new(0.0, 0.0, 3.0))
}

pub fn bench(s) {
    for i in 0..100 {
        let d = s.determinant();
    }
}
