// 100 operations per call: the cost of one is (this - `empty loop`) / 100
// the same operations on values living in the VM: objects and functions written in Rune
fn new(x, y, z) { #{x: x, y: y, z: z} }
fn length(v) { (v.x * v.x + v.y * v.y + v.z * v.z).sqrt() }
fn add(a, b) { new(a.x + b.x, a.y + b.y, a.z + b.z) }

pub fn pre_bench() {
    (new(1.0, 2.0, 3.0), new(4.0, 5.0, 6.0), #{translation: new(1.0, 2.0, 3.0)})
}

pub fn bench(s) {
    let (v, w, t) = s;
    for i in 0..100 {
        v.x = 1.0;
    }
}
