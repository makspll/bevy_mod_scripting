pub fn main() {
    // TextFont constructors and builders
    let Justify = import_namespace("text").Justify;
    let TextFont = import_namespace("text").TextFont;
    let TextLayout = import_namespace("text").TextLayout;
    let font = TextFont.from_font_size(20.0);
    assert!(font != (), "from_font_size");
    assert!(font.with_font_size(30.0) != (), "with_font_size");

    // TextLayout constructors
    assert!(TextLayout.new_with_no_wrap() != (), "new_with_no_wrap");
    assert!(TextLayout.new_with_justify(Justify.Center) != (), "new_with_justify");
}
