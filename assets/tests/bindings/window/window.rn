pub fn main() {
    // the test app has no windows
    let Window = import_namespace("window").Window;
    let WindowResolution = import_namespace("window").WindowResolution;

    assert!(Window.primary() == (), "primary is nil without windows");
    assert!(Window.primary_entity() == (), "primary_entity is nil without windows");

    // resolutions
    let resolution = WindowResolution.new(800, 600);
    assert!(resolution.physical_width == 800, "physical_width");
    assert!(resolution.physical_height == 600, "physical_height");
    assert!(resolution.width() == 800.0, "width");
    assert!(resolution.height() == 600.0, "height");
    resolution.set(1024.0, 768.0);
    assert!(resolution.width() == 1024.0, "set width");
    assert!(resolution.height() == 768.0, "set height");
}
