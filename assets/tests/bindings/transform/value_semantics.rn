// small values (i.e. `Vec3`, `Entity`) are stored inline instead of allocated, scripts must not be able to tell
pub fn main() {
    let world = import_namespace("bms").world;
    let Transform = import_namespace("transform").Transform;
    let Vec3 = import_namespace("math").Vec3;

    // two variables holding the same value see each other's changes, like for allocated values
    let a = Vec3.new(1.0, 2.0, 3.0);
    let b = a;
    b.x = 5.0;
    assert!(a.x == 5.0, "aliases share the value");

    // assigning a value copies it into the place, reads of fields are places
    let t = Transform.from_xyz(1.0, 2.0, 3.0);
    let v = Vec3.new(7.0, 8.0, 9.0);
    t.translation = v;
    v.x = 10.0;
    assert!(t.translation.x == 7.0, "assignment copies the value");
    t.translation.y = 1.0;
    assert!(t.translation.y == 1.0, "fields are places");
    let translation = t.translation;
    translation.z = 4.0;
    assert!(t.translation.z == 4.0, "a field read into a variable is still the place");

    // functions, operators and display work on values
    assert!(a.length() > 0.0, "methods");
    assert!((a + Vec3.new(1.0, 0.0, 0.0)).x == 6.0, "operators");
    assert!(a == Vec3.new(5.0, 2.0, 3.0), "equality");
    assert!(`${Vec3.new(1.0, 2.0, 3.0)}` != "", "display");

    // entities returned by functions and read from fields are equal
    let parent = world.spawn();
    let child = world.spawn();
    world.push_children(parent, [child]);
    let child_of = world.get_component(child, world.get_type_by_name("bevy_ecs::hierarchy::ChildOf"));
    assert!(child_of[0] == parent, "field == value");
    assert!(parent == child_of[0], "value == field");
    assert!(child_of.parent() == parent, "function result == value");
    assert!(world.get_parent(child) == parent, "function results are equal");
}
