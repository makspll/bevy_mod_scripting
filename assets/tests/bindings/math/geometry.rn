fn approx(a, b) {
    (a - b).abs() < 0.0001
}

pub fn main() {
    let Cuboid = import_namespace("math").Cuboid;
    let Dir3 = import_namespace("math").Dir3;
    let EaseFunction = import_namespace("math").EaseFunction;
    let Ray3d = import_namespace("math").Ray3d;
    let Rect = import_namespace("math").Rect;
    let Rectangle = import_namespace("math").Rectangle;
    let Rot2 = import_namespace("math").Rot2;
    let Vec2 = import_namespace("math").Vec2;
    let Vec3 = import_namespace("math").Vec3;

    // directions
    let dir = Dir3.new(Vec3.new(0, 0, 5));
    assert!(dir.as_vec3() == Vec3.unit_z(), "dir is normalized");
    assert!(Dir3.new(Vec3.zero()) == (), "zero vector is not a direction");
    assert!(Dir3.y().as_vec3() == Vec3.unit_y(), "dir constant");
    assert!(dir * 2 == Vec3.new(0, 0, 2), "scaled direction");

    // 2d rotations
    let rot = Rot2.degrees(90);
    assert!(approx(rot.as_radians(), math::PI / 2.0), "rot2 degrees");
    let rotated = rot * Vec2.unit_x();
    assert!(approx(rotated.x, 0.0) && approx(rotated.y, 1.0), "rot2 * vec2");

    // rectangles
    let rect = Rect.new(0, 0, 4, 2);
    assert!(rect.width() == 4.0 && rect.height() == 2.0, "rect size");
    assert!(rect.center() == Vec2.new(2, 1), "rect center");
    assert!(rect.contains(Vec2.new(1, 1)), "rect contains");
    assert!(!rect.contains(Vec2.new(5, 1)), "rect does not contain");
    assert!(rect.intersect(Rect.new(2, 0, 6, 2)).width() == 2.0, "rect intersect");

    // rays
    let ray = Ray3d.new(Vec3.new(0, 10, 0), Vec3.new(0, -1, 0));
    assert!(ray.get_point(4) == Vec3.new(0, 6, 0), "ray point");
    assert!(approx(ray.intersect_plane(Vec3.zero(), Vec3.unit_y()), 10.0), "ray hits plane");
    assert!(ray.intersect_plane(Vec3.new(0, 20, 0), Vec3.unit_y()) == (), "ray misses plane behind it");
    assert!(catch(|| Ray3d.new(Vec3.zero(), Vec3.zero())).is_err(), "zero direction errors");

    // shapes (`Sphere` is not tested: its short name is shared with another bevy type)
    assert!(Cuboid.new(2, 4, 6).half_size == Vec3.new(1, 2, 3), "cuboid");
    assert!(Rectangle.new(2, 4).half_size == Vec2.new(1, 2), "rectangle");

    // easing, variants can be passed directly
    assert!(EaseFunction.sample(EaseFunction.Linear, 0.25) == 0.25, "linear easing");
    assert!(approx(EaseFunction.sample(EaseFunction.QuadraticIn, 0.5), 0.25), "quadratic easing");
    assert!(EaseFunction.sample(EaseFunction.QuadraticIn, 2) == 1.0, "easing is clamped");
}
