pub fn main() {
    let world = import_namespace("bms").world;
    let entity = world.spawn();
    let _type = world.get_type_by_name("test_utils::test_data::CompWithFromWorldAndComponentData");
    world.add_default_component(entity, _type);

    assert!(world.has_component(entity, _type), "Component not added");

    let component = world.get_component(entity, _type);
    assert!(component[0] == "Default", "Component did not have default value, got: {}", component[0]);
}
