// The inventory test of `../inventory/inventory.lua` in Rune.
// Closures handed to BMS can only capture numbers and strings in Rune, so functions are given the signals
// and entities they need as dependencies. What the Lua script keeps in globals is in `state()`.

fn contains(list, value) {
    for v in list {
        if v == value {
            return true;
        }
    }
    false
}

// called with its arguments instead of a props table, see `Slot.call(..)` below
fn slot(name, entity, is_selected, selected, clicks) {
    let ui = import_namespace("reactive_ui");
    let item = ui.watch(entity, state()["Item"]);
    ui.node(#{
        name: `slot_${name}`,
        // computed in Rust, no script code runs when these change
        background_color: ui.when(ui.selected(is_selected, name), "#ffcc00", "#333333"),
        // a function with its dependencies
        on_click: [|selected, clicks, name, _event| {
            selected.set(name);
            clicks.set(clicks.peek() + 1);
        }, selected, clicks, name],
    }, [
        ui.text(#{ name: `count_${name}`, text: ui.format("x{}", [ui.path(item, "data.count")]) }),
    ])
}

fn details(p) {
    let ui = import_namespace("reactive_ui");
    // read wherever the component is, without going through the props of what is in between
    let label = ui.use_context(state()["Labels"]).details;
    ui.text(#{ name: "details", text: `${label}${p.name}` })
}

fn inventory(p) {
    let ui = import_namespace("reactive_ui");
    let s = state();
    let hp = ui.watch(p.player, s["Health"]);
    let selected = ui.signal(());
    let is_selected = ui.selector(selected);
    let clicks = ui.signal(0);
    // functions with their dependencies: `[f, a, b]` calls `f(a, b)`
    let visible = ui.computed([|search, items| {
        let query = search.get();
        let out = [];
        for name in items.get() {
            if name.to_lowercase().contains(query) {
                out.push(name);
            }
        }
        // a Rune closure ending in a bare local returns nothing, `return` it
        return out;
    }, s["search"], s["items"]]);
    let visible_entities = ui.computed([|visible, entities| {
        let out = [];
        for name in visible.get() {
            out.push(entities[name]);
        }
        return out;
    }, visible, s["entities"]]);
    ui.effect([|selected, items| {
        // a string can't be compared with `()` in Rune, match instead
        match selected.get() {
            () => {}
            name => {
                if !contains(items.get(), name) {
                    selected.set(());
                }
            }
        }
    }, selected, s["items"]]);

    let reloads = s["reloads"];
    ui.node(#{
        name: "panel", flex_direction: "Column", justify_content: "SpaceBetween", max_width: "50%",
        padding: [4, 8], border: 1, border_color: "#ffffff", border_radius: 3,
    }, [
        ui.text(#{ name: "version", text: `v${reloads}`, font_size: 20, color: "#ff0000" }),
        ui.image(#{ name: "icon", image: "icons/sword.png", width: 16, height: 16 }),
        ui.text(#{ name: "title", text: [|visible| {
            let count = visible.get().len();
            `Inventory (${count})`
        }, visible] }),
        ui.text(#{ name: "hp", text: ui.format("{}/{}", [ui.path(hp, "data.current"), ui.path(hp, "data.max")]) }),
        ui.show([|hp| {
            let h = hp.get().data;
            if h.current * 4 < h.max {
                import_namespace("reactive_ui").text(#{ key: "low", name: "low", text: "LOW HP" })
            } else {
                ()
            }
        }, hp]),
        // an empty path is the value itself
        ui.text(#{ name: "clicks", text: ui.format("clicks: {}", [ui.path(clicks, "")]) }),
        // one child per item, only built for new items
        ui.list(visible, [|is_selected, selected, clicks, entities, name| {
            // `Slot` renders with these values, `Details` below gets a props table through Rust.
            // Components are functions taking any number of arguments, which Rune calls with `call`
            state()["Slot"].call(name, entities[name], is_selected, selected, clicks)
        }, is_selected, selected, clicks, s["entities"]]),
        // the region below is mounted later, and still sees what is provided here
        ui.provide(s["Labels"], #{ details: "selected: " }, [
            ui.show([|selected| {
                match selected.get() {
                    () => (),
                    name => import_namespace("reactive_ui").keyed(name, state()["Details"].call(#{ name: name })),
                }
            }, selected]),
        ]),
        // a row template: runs once, `item` stands for the entity of each row, functions get the row's entity
        ui.list_template(visible_entities, [|is_selected, item| {
            let ui = import_namespace("reactive_ui");
            let Item = state()["Item"];
            let data = ui.watch_item(item, Item);
            let name = ui.path(data, "data.name");
            ui.node(#{
                name: ui.format("row_{}", [name]),
                background_color: ui.when(ui.selected(is_selected, name), "#ffcc00", "#333333"),
                on_click: |entity, _event| {
                    let world = import_namespace("bms").world;
                    let s = state();
                    s["row_clicked"] = world.get_component(entity, s["Item"]).data.name;
                },
            }, [
                ui.text(#{ name: ui.format("row_text_{}", [name]), text: ui.format("{} x{}", [name, ui.path(data, "data.count")]) }),
            ])
        }, is_selected]),
    ])
}

pub fn main() {
    let bms = import_namespace("bms");
    let world = bms.world;
    let ui = import_namespace("reactive_ui");
    let s = state();
    // the state survives reloads
    if s["reloads"] is i64 {
        s["reloads"] = s["reloads"] + 1;
    } else {
        s["reloads"] = 1;
        let Health = world.register_new_component("script.reactive_ui", "Health", true);
        let Item = world.register_new_component("script.reactive_ui", "Item", true);
        s["Health"] = Health;
        s["Item"] = Item;
        let player = world.spawn();
        world.insert_component(player, Health, bms.DynamicComponent.new(#{ data: #{ current: 100, max: 100 } }));
        s["player"] = player;
        let entities = #{};
        for name in ["Sword", "Shield", "Potion"] {
            let e = world.spawn();
            world.insert_component(e, Item, bms.DynamicComponent.new(#{ data: #{ name: name, count: 1 } }));
            entities[name] = e;
        }
        s["entities"] = entities;
        s["items"] = ui.signal(["Sword", "Shield", "Potion"]);
        s["search"] = ui.signal("");
        s["Labels"] = ui.create_context(#{ details: "details: " });
    }
    // defined again on every load, which renders their instances with the new code
    s["Slot"] = ui.component("Slot", slot);
    s["Details"] = ui.component("Details", details);
    s["Inventory"] = ui.component("Inventory", inventory);
}

pub fn on_script_loaded() {
    let ui = import_namespace("reactive_ui");
    let s = state();
    s["root"] = ui.render("inventory", s["Inventory"].call(#{ player: s["player"] }));
}

// the test, with `reactive_ui_test`: events and `act` run what they change before returning

fn expect_text(screen, name, expected) {
    screen.expect_style(screen.get_by_name(name), #{ text: expected });
}

fn first_load(screen) {
    let t = import_namespace("reactive_ui_test");
    let s = state();
    // properties are checked as the script sets them
    screen.expect_style(screen.get_by_name("panel"), #{
        flex_direction: "Column", justify_content: "SpaceBetween", max_width: "50%",
        padding: [4, 8], border: 1, border_color: "#ffffff", border_radius: 3,
    });
    screen.expect_style(screen.get_by_name("version"), #{ text: "v1", font_size: 20, color: "#ff0000" });
    screen.expect_style(screen.get_by_name("icon"), #{ image: "icons/sword.png", width: 16, height: 16 });
    // laid out in a 1280x720 window
    let icon = screen.rect(screen.get_by_name("icon"));
    let panel = screen.rect(screen.get_by_name("panel"));
    assert!(icon.width == 16.0 && icon.height == 16.0, "the icon is {}x{}", icon.width, icon.height);
    assert!(panel.x == 0.0 && panel.y == 0.0 && panel.width <= 640.0, "the panel is at {}, {}", panel.x, panel.y);
    expect_text(screen, "title", "Inventory (3)");
    expect_text(screen, "hp", "100/100");
    assert!(screen.query_by_name("low") == (), "low hp shown at full health");
    expect_text(screen, "clicks", "clicks: 0");
    expect_text(screen, "count_Sword", "x1");
    assert!(screen.get_by_text("Sword x1") == screen.get_by_name("row_text_Sword"), "rows are found by their text");
    assert!(screen.query_by_name("details") == (), "details shown without a selection");
    screen.updates();

    // a watched component changes
    screen.act(|| {
        let s = state();
        let hp = import_namespace("bms").world.get_component(s["player"], s["Health"]);
        hp.data = #{ current: 20, max: 100 };
    });
    expect_text(screen, "hp", "20/100");
    expect_text(screen, "low", "LOW HP");
    let updates = screen.updates();
    assert!(updates.renders.get("Inventory") == None, "the component rendered again");
    assert!(updates.bindings == 1 && updates.regions == 1, "only the hp text and the low hp region run again");

    // a click handler sets component state, a click on the text inside a row reaches the row's handler
    screen.click(screen.get_by_name("slot_Sword"));
    screen.click(screen.get_by_name("row_text_Shield"));
    expect_text(screen, "details", "selected: Sword");
    expect_text(screen, "clicks", "clicks: 1");
    screen.expect_style(screen.get_by_name("slot_Sword"), #{ background_color: "#ffcc00" });
    screen.expect_style(screen.get_by_name("slot_Shield"), #{ background_color: "#333333" });
    screen.expect_style(screen.get_by_name("row_Sword"), #{ background_color: "#ffcc00" });
    assert!(s["row_clicked"] == "Shield", "the row handler did not get its entity");
    let row = screen.within(screen.get_by_name("row_Shield"));
    assert!(row.query_by_text("Sword x1") == () && row.all_by_text("Shield x1").len() == 1, "within finds inside the row only");

    // a global signal filters a keyed list
    screen.act(|| state()["search"].set("sh"));
    expect_text(screen, "title", "Inventory (1)");
    assert!(screen.query_by_name("row_Sword") == (), "filtered out row still shown");
    assert!(screen.query_by_name("slot_Sword") == (), "filtered out slot still shown");
    assert!(screen.query_by_name("slot_Shield") != (), "matching slot not shown");
    expect_text(screen, "details", "selected: Sword");

    // a list item's watched component changes
    screen.act(|| {
        let s = state();
        let shield = import_namespace("bms").world.get_component(s["entities"]["Shield"], s["Item"]);
        shield.data = #{ name: "Shield", count: 5 };
    });
    expect_text(screen, "count_Shield", "x5");
    expect_text(screen, "row_text_Shield", "Shield x5");

    // an effect clears the selection once the item is gone
    screen.act(|| {
        let s = state();
        import_namespace("bms").world.despawn(s["entities"]["Sword"]);
        s["items"].set(["Shield", "Potion"]);
    });
    assert!(screen.query_by_name("details") == (), "selection of a removed item was not cleared");

    // a component rendered on its own, with a context provided
    let d = t.render(s["Details"].call(#{ name: "Potion" }), [t.context(s["Labels"], #{ details: "given: " })]);
    expect_text(d, "details", "given: Potion");
    // the whole tree as text, the same for the same ui
    let snapshot = d.snapshot();
    assert!(snapshot == "text name=\"details\" text=\"given: Potion\"\n", "{}", snapshot);
    expect_text(t.render(s["Details"].call(#{ name: "Potion" })), "details", "details: Potion");
}

// after a reload the new code renders and the state survives
fn after_reload(screen) {
    expect_text(screen, "version", "v2");
    expect_text(screen, "title", "Inventory (1)");
    expect_text(screen, "clicks", "clicks: 1");
    expect_text(screen, "hp", "20/100");
    expect_text(screen, "count_Shield", "x5");
    expect_text(screen, "row_text_Shield", "Shield x5");
}

pub fn on_test() {
    let s = state();
    let screen = import_namespace("reactive_ui_test").screen(s["root"]);
    let reloads = s["reloads"];
    if reloads == 1 {
        first_load(screen);
    } else {
        after_reload(screen);
    }
    `load ${reloads}`
}
