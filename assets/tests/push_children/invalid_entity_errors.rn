pub fn main() {
    let world = import_namespace("bms").world;
    let test_utils = import_namespace("test_utils");
    let fake_entity = test_utils._make_invalid_entity();

    assert_throws(|| {
        world.push_children(fake_entity, [fake_entity]);
    }, "Missing or invalid entity");

    let entity = world.spawn();
    assert_throws(|| {
        world.push_children(entity, [fake_entity]);
    }, "Missing or invalid entity");
}
