pub fn main() {
    let world = import_namespace("bms").world;
    let type = world.get_type_by_name("test_utils::test_data::TestComponent");

    assert!(type != (), "Type not found");
    let type_name = type.type_name();
    let short_name = type.short_name();
    assert!(type_name == "test_utils::test_data::TestComponent",
        "type_name mismatch, expected: test_utils::test_data::TestComponent, got: {}", type_name);
    assert!(short_name == "TestComponent", "short_name mismatch, expected: TestComponent, got: {}", short_name);

    // check contains ScriptComponentRegistration
    let type_ref = type.display();
    assert!(type_ref.contains("ScriptComponentRegistration"), "ScriptComponentRegistration not found in type_ref. got: {}", type_ref);
}
