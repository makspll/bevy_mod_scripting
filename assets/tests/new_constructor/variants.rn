pub fn main() {
    let world = import_namespace("bms").world;
    let SimpleEnum = import_namespace("test_utils").SimpleEnum;
    let SimpleStruct = import_namespace("test_utils").SimpleStruct;

    let value = SimpleEnum.new(#{ variant: "Struct", foo: 1 });

    // discriminating variants
    assert!(value.variant() == SimpleEnum.Struct, "expected value to be the Struct variant");
    assert!(value.variant() != SimpleEnum.Unit, "expected value not to be the Unit variant");
    assert!(SimpleEnum.Unit.variant_name() == "Unit", "expected variant name Unit");

    // constructing from variants
    let constructed = SimpleEnum.Struct.new(#{ foo: 5 });
    assert!(constructed.variant() == SimpleEnum.Struct, "expected Struct variant");
    assert!(constructed.foo == 5, "expected foo to be 5 but got {}", constructed.foo);

    let tuple = SimpleEnum.TupleStruct.new(#{ "0": 7 });
    assert!(tuple.variant() == SimpleEnum.TupleStruct, "expected TupleStruct variant");
    assert!(tuple[0] == 7, "expected first field to be 7 but got {}", tuple[0]);

    let unit = SimpleEnum.Unit.new(#{});
    assert!(unit.variant() == SimpleEnum.Unit, "expected Unit variant");

    // the escape hatch for names shadowed by functions
    let type = world.get_type_by_name("test_utils::test_data::SimpleEnum");
    assert!(world.get_enum_variant(type, "Unit") == SimpleEnum.Unit, "expected get_enum_variant to find Unit");
    assert!(world.get_enum_variant(type, "Missing") == (), "expected no such variant");

    // non enums have no variant
    assert!(SimpleStruct.new(#{}).variant() == (), "expected structs to have no variant");

    // variants take positional fields too
    let positional_tuple = SimpleEnum.TupleStruct.new([8]);
    assert!(positional_tuple[0] == 8, "expected first field to be 8 but got {}", positional_tuple[0]);
}
