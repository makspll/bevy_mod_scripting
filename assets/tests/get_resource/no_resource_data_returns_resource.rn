pub fn main() {
    let world = import_namespace("bms").world;
    let resource = world.get_type_by_name("test_utils::test_data::ResourceWithDefault");

    let retrieved = world.get_resource(resource);
    assert!(retrieved != (), "Resource should exist");
    assert!(retrieved[0] == "Initial Value", "Resource should have default value but got: {}", retrieved[0]);
}
