pub fn main() {
    let world = import_namespace("bms").world;
    let resource = world.get_type_by_name("test_utils::test_data::TestResource");

    let retrieved = world.get_resource(resource);
    assert!(retrieved != (), "Resource should exist");
    assert!(retrieved.bytes[1] == 1, "Resource should have default value but got {}", retrieved.bytes[1]);
}
